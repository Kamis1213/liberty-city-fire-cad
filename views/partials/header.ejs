<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title || "Liberty City Fire CAD" %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div id="dispatch-alert" class="dispatch-alert hidden" role="alert" aria-live="assertive"></div>
<header class="topbar">
  <div>
    <div class="brand">LIBERTY CITY FIRE DEPARTMENT</div>
    <div class="subbrand">Computer Aided Dispatch</div>
  </div>
  <% if (user) { %>
    <div class="userbox">
      <strong><%= user.callsign ? user.callsign + " · " : "" %><%= user.name %></strong>
      <span><%= user.rank || user.role %></span>
      <button id="enable-audio" class="audio-btn" type="button">Enable Dispatch Audio</button>
      <a href="/logout">Logout</a>
    </div>
  <% } %>
</header>
<% if (user) { %>
<nav class="nav">
  <% if (user && typeof session !== "undefined" && session && session.mode === "OFFICER") { %>
    <a href="/officer">Officer CAD</a>
    <a href="/member">My Call</a>
    <a href="/reports">Reports</a>
    <a href="/select-mode">Switch Mode</a>
    <a href="/logout">Logout</a>
  <% } else { %>
    <a href="/select-mode">Mode</a>
    <% if (user) { %>
      <% if (["DISPATCH","COMMAND","ADMIN"].includes(user.role)) { %><a href="/dashboard">Dispatch</a><% } %>
      <a href="/mdt">MDT</a>
      <a href="/member">Member</a>
      <% if (["DISPATCH","COMMAND","ADMIN"].includes(user.role)) { %><a href="/history">History</a><% } %>
      <a href="/reports">Reports</a>
      <% if (["COMMAND","ADMIN"].includes(user.role)) { %>
        <a href="/admin/units">Units</a>
        <a href="/admin/stations">Stations</a>
        <a href="/admin/personnel">Personnel</a>
        <a href="/admin/loa">LOA Requests</a>
      <% } %>
      <% if (user.role === "ADMIN") { %><a href="/admin/users">Users</a><% } %>
      <a href="/logout">Logout</a>
    <% } %>
  <% } %>
</nav>
<% } %>
<main class="container">
