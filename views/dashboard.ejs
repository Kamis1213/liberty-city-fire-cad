<%- include("partials/header", { title: "Dispatch Dashboard" }) %>
<div class="grid two">
  <section class="card">
    <h2>Create Incident</h2>
    <form method="post" action="/incidents" class="stack">
      <label>Call Type<input name="call_type" placeholder="Structure Fire" required></label>
      <label>Address<input name="address" placeholder="100 Liberty Ave" required></label>
      <label>Notes<textarea name="notes" rows="4" placeholder="Caller information / hazards / details"></textarea></label>
      <fieldset>
        <legend>Dispatch Units</legend>
        <div class="checkbox-grid">
          <% units.forEach(unit => { %>
            <label class="check">
              <input type="checkbox" name="unit_ids" value="<%= unit.id %>" <%= unit.status !== "AVAILABLE" ? "disabled" : "" %>>
              <span><strong><%= unit.unit_name %></strong><br><small><%= unit.status %></small></span>
            </label>
          <% }) %>
        </div>
      </fieldset>
      <button type="submit">Create & Dispatch Incident</button>
    </form>
  </section>

  <section class="card">
    <h2>Unit Status</h2>
    <div class="unit-grid">
      <% units.forEach(unit => { %>
        <div class="unit-card">
          <strong><%= unit.unit_name %></strong>
          <span><%= unit.unit_type %></span>
          <span class="status"><%= unit.status %></span>
        </div>
      <% }) %>
    </div>
  </section>
</div>

<section class="card">
  <h2>Active Incidents</h2>
  <% if (!incidents.length) { %>
    <p class="muted">No active incidents.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Incident</th><th>Type</th><th>Address</th><th>Units</th><th>Status</th><th>Update</th></tr></thead>
        <tbody>
        <% incidents.forEach(i => { %>
          <tr>
            <td><strong><%= i.incident_number %></strong><br><small><%= new Date(i.created_at).toLocaleString() %></small></td>
            <td><%= i.call_type %></td>
            <td><%= i.address %><br><small><%= i.notes %></small></td>
            <td><%= i.units || "None" %></td>
            <td><span class="status"><%= i.status %></span></td>
            <td>
              <form method="post" action="/incidents/<%= i.id %>/status" class="inline">
                <select name="status">
                  <% ["PENDING","DISPATCHED","EN ROUTE","ON SCENE","CLOSED"].forEach(s => { %>
                    <option value="<%= s %>" <%= s === i.status ? "selected" : "" %>><%= s %></option>
                  <% }) %>
                </select>
                <button type="submit">Set</button>
              </form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include("partials/footer") %>
