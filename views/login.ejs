<%- include("partials/header", { title: "CAD Login" }) %>
<div class="login-wrap">
  <section class="card login-card">
    <h1>CAD Login</h1>
    <p class="muted">Authorized Liberty City Fire Department personnel only.</p>
    <% if (error) { %><div class="alert danger"><%= error %></div><% } %>
    <form method="post" action="/login" class="stack">
      <label>Username<input name="username" required autofocus></label>
      <label>Password<input name="password" type="password" required></label>
      <label>Callsign<input name="callsign" required placeholder="Example: SQUAD-2"></label>
      <button type="submit">Sign In</button>
    </form>
  </section>
</div>
<%- include("partials/footer") %>