<%- include("partials/header", { title: "MDT" }) %><section class="card"><h1>Apparatus MDT</h1><div class="unit-grid"><% units.forEach(unit=>{ %><article class="unit-card large"><h3><%= unit.unit_name %></h3><div class="status"><%= unit.status %></div><% if(unit.incident_number){ %><hr><strong><%= unit.incident_number %> — <%= unit.call_type %></strong><p><%= unit.address %></p><p class="muted"><%= unit.notes %></p><% } else { %><p class="muted">No active assignment.</p><% } %><form method="post" action="/mdt/units/<%= unit.id %>/status" class="mdt-buttons"><button name="status" value="EN ROUTE">EN ROUTE</button><button name="status" value="ON SCENE">ON SCENE</button><button name="status" value="TRANSPORTING">TRANSPORTING</button><button name="status" value="AT HOSPITAL">AT HOSPITAL</button><button name="status" value="AVAILABLE" class="secondary">AVAILABLE</button><button name="status" value="OUT OF SERVICE" class="danger">OOS</button></form></article><% }) %></div></section><%- include("partials/footer") %>