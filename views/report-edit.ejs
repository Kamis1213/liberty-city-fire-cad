<%- include("partials/header", { title: "Incident Report" }) %><section class="card"><h1><%= incident.incident_number %> — <%= incident.call_type %></h1><p><strong><%= incident.address %></strong><br><%= incident.units || 'No units' %></p><p class="muted"><%= incident.notes %></p><h2>Responding Crew</h2><% if(!crew.length){ %><p class="muted">No crew snapshot recorded.</p><% } else { %><div class="crew-chips"><% crew.forEach(c=>{ %><span><strong><%= c.unit_name %></strong>: <%= c.member_rank %> <%= c.member_name %> — <%= c.position %></span><% }) %></div><% } %></section><section class="card"><h2>Officer Report</h2><% if(canEdit){ %><form method="post" action="/reports/<%= incident.id %>" class="stack"><label>Narrative<textarea name="narrative" rows="8" required><%= report?.narrative || '' %></textarea></label><label>Actions Taken<textarea name="actions_taken" rows="4"><%= report?.actions_taken || '' %></textarea></label><label>Disposition<input name="disposition" value="<%= report?.disposition || '' %>" placeholder="Cleared / Transferred / Investigating"></label><label>Injuries<input name="injuries" value="<%= report?.injuries || '' %>"></label><label>Property Damage<input name="property_damage" value="<%= report?.property_damage || '' %>"></label><button type="submit">SAVE INCIDENT REPORT</button></form><% } else if(report){ %><p><strong>Filed by:</strong> <%= report.officer_name %></p><p><%= report.narrative %></p><p><strong>Actions:</strong> <%= report.actions_taken %></p><p><strong>Disposition:</strong> <%= report.disposition %></p><% } else { %><p class="muted">No report has been filed.</p><% } %></section><%- include("partials/footer") %>