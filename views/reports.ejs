<%- include("partials/header", { title: "Incident Reports" }) %><section class="card"><h1>Incident Reports</h1><div class="table-wrap"><table><thead><tr><th>Incident</th><th>Type</th><th>Address</th><th>Status</th><th>Report</th></tr></thead><tbody><% incidents.forEach(i=>{ %><tr><td><a href="/reports/<%= i.id %>"><strong><%= i.incident_number %></strong></a><br><small><%= new Date(i.created_at).toLocaleString() %></small></td><td><%= i.call_type %></td><td><%= i.address %></td><td><%= i.status %></td><td><%= i.report_id ? 'FILED — '+i.officer_name : 'NOT FILED' %></td></tr><% }) %></tbody></table></div></section><%- include("partials/footer") %>