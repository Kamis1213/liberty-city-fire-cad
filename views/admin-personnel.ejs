<%- include("partials/header", { title: "Personnel & Rosters" }) %>

<div class="page-heading">
  <div>
    <h1>Personnel & Rosters</h1>
    <p class="muted">Create department members, assign ranks and callsigns, and staff apparatus.</p>
  </div>
  <a class="button-link secondary-link" href="/dashboard">Back to Dispatch</a>
</div>

<div class="grid two">
  <% if (canManageRoster) { %>
  <section class="card">
    <h2>Add Personnel</h2>
    <form method="post" action="/admin/personnel" class="stack">
      <label>Name<input name="name" placeholder="John Smith" required maxlength="100"></label>
      <label>Rank
        <select name="rank">
          <% [
            "Fire Commissioner","Deputy Fire Commissioner","Chief of Department","Deputy Chief",
            "Assistant Chief","Division Chief","Battalion Chief","Captain","Lieutenant",
            "Engineer / Driver Operator","Senior Firefighter","Firefighter III","Firefighter II",
            "Firefighter I","Probationary Firefighter","Fire Cadet / Recruit"
          ].forEach(r => { %><option value="<%= r %>"><%= r %></option><% }) %>
        </select>
      </label>
      <label>Callsign<input name="callsign" placeholder="Car 1 / E1-1 / 101"></label>
      <label>Badge Number<input name="badge_number" placeholder="101"></label>
      <label>Home Station
        <select name="station_id">
          <option value="">Unassigned</option>
          <% stations.forEach(st => { %><option value="<%= st.id %>"><%= st.station_name %></option><% }) %>
        </select>
      </label>
      <button type="submit">+ Add Member</button>
    </form>
  </section>
  <% } %>

  <section class="card">
    <h2>Roster & Staffing</h2>
    <p>Personnel can have a department rank, callsign, badge number, home station, and current apparatus assignment.</p>
    <p class="muted">Staffing an apparatus makes that member appear as crew on the Unit Management screen.</p>
  </section>
</div>

<section class="card">
  <h2>Department Personnel</h2>
  <% if (!personnel.length) { %>
    <p class="muted">No personnel have been created yet.</p>
  <% } else { %>
    <div class="personnel-grid">
      <% personnel.forEach(p => { %>
        <article class="unit-card large personnel-card">
          <div class="unit-card-head">
            <div>
              <div class="unit-type-tag"><%= p.rank %></div>
              <h3><%= p.name %></h3>
              <div class="station-label">
                <%= p.callsign ? p.callsign + " · " : "" %><%= p.station_name || "Unassigned Station" %>
              </div>
            </div>
            <div class="status status-pill <%= p.active ? "status-available" : "status-out-of-service" %>">
              <%= p.active ? "ACTIVE" : "INACTIVE" %>
            </div>
          </div>

          <% if (canStaff) { %>
          <form method="post" action="/admin/personnel/<%= p.id %>/staff" class="stack roster-staff-form">
            <label>Current Apparatus
              <select name="unit_id">
                <option value="">Not Staffed</option>
                <% units.forEach(u => { %>
                  <option value="<%= u.id %>" <%= Number(p.unit_id) === Number(u.id) ? "selected" : "" %>><%= u.unit_name %></option>
                <% }) %>
              </select>
            </label>
            <label>Position
              <select name="position">
                <% ["Officer","Driver / Engineer","Firefighter","Medic","Chief Officer","Other"].forEach(pos => { %>
                  <option value="<%= pos %>" <%= p.position === pos ? "selected" : "" %>><%= pos %></option>
                <% }) %>
              </select>
            </label>
            <button type="submit">Assign to Unit</button>
          </form>
          <% } %>

          <% if (canManageRoster) { %>
          <details>
            <summary>Edit Member</summary>
            <form method="post" action="/admin/personnel/<%= p.id %>/edit" class="stack compact-form">
              <label>Name<input name="name" value="<%= p.name %>" required></label>
              <label>Rank
                <select name="rank">
                  <% [
                    "Fire Commissioner","Deputy Fire Commissioner","Chief of Department","Deputy Chief",
                    "Assistant Chief","Division Chief","Battalion Chief","Captain","Lieutenant",
                    "Engineer / Driver Operator","Senior Firefighter","Firefighter III","Firefighter II",
                    "Firefighter I","Probationary Firefighter","Fire Cadet / Recruit"
                  ].forEach(r => { %><option value="<%= r %>" <%= p.rank === r ? "selected" : "" %>><%= r %></option><% }) %>
                </select>
              </label>
              <label>Callsign<input name="callsign" value="<%= p.callsign || "" %>"></label>
              <label>Badge Number<input name="badge_number" value="<%= p.badge_number || "" %>"></label>
              <label>Home Station
                <select name="station_id">
                  <option value="">Unassigned</option>
                  <% stations.forEach(st => { %>
                    <option value="<%= st.id %>" <%= Number(p.station_id) === Number(st.id) ? "selected" : "" %>><%= st.station_name %></option>
                  <% }) %>
                </select>
              </label>
              <label class="check"><input type="checkbox" name="active" <%= p.active ? "checked" : "" %>><span>Active Member</span></label>
              <button class="secondary" type="submit">Save Member</button>
            </form>
          </details>
          <% } %>

          <% if (user.role === "COMMAND" || user.role === "ADMIN") { %>
            <form method="post" action="/admin/personnel/<%= p.id %>/delete"
                  onsubmit="return confirm('Delete <%= p.name %> from the roster?');">
              <button class="danger-btn full-width" type="submit">Delete Member</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>
