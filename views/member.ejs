<%- include("partials/header", { title: "Member Portal" }) %>
<div class="grid two"><section class="card"><h1>Duty / Shift</h1><p><strong><%= member.name %></strong><br><%= member.rank || "Member" %> — <%= member.role %></p>
<% if (member.on_duty && crew) { %><div class="alert success"><strong>ON DUTY</strong><br><%= crew.unit_name %> — <%= crew.position %><% if(member.duty_started_at){ %><br><small>Since <%= new Date(member.duty_started_at).toLocaleString() %></small><% } %></div><form method="post" action="/member/unstaff"><button class="danger" type="submit">GO OFF DUTY</button></form>
<% } else { %><form method="post" action="/member/staff" class="stack"><label>Station<select name="station_id" id="duty-station"><option value="">Choose station</option><% stations.forEach(s=>{ %><option value="<%= s.id %>"><%= s.station_name %></option><% }) %></select></label><label>Apparatus<select name="unit_id" id="duty-unit" required><option value="">Choose apparatus</option><% units.forEach(u=>{ %><option value="<%= u.id %>" data-station="<%= u.station_id || '' %>"><%= u.unit_name %> — <%= u.station_name || 'Unassigned' %></option><% }) %></select></label><label>Position<select name="position" required><option>OFFICER</option><option>DRIVER</option><option>FIREFIGHTER 1</option><option>FIREFIGHTER 2</option><option>MEDIC</option><option>ADDITIONAL CREW</option></select></label><button type="submit">GO ON DUTY</button></form><% } %></section>
<section class="card"><h2>Change Password</h2><form method="post" action="/member/password" class="stack"><label>Current Password<input type="password" name="current_password" required></label><label>New Password<input type="password" name="new_password" minlength="8" required></label><button type="submit" class="secondary">Change Password</button></form></section></div>
<div class="grid two"><section class="card"><h2>Request Leave of Absence</h2><form method="post" action="/loa" class="stack"><label>Start Date<input type="date" name="start_date" required></label><label>End Date<input type="date" name="end_date" required></label><label>Reason<textarea name="reason" rows="4" required></textarea></label><button type="submit">Submit LOA Request</button></form></section><section class="card"><h2>My LOA Requests</h2><% if(!loaRequests.length){ %><p class="muted">No LOA requests submitted.</p><% } else { %><% loaRequests.forEach(l=>{ %><p><strong><%= l.status %></strong> — <%= new Date(l.start_date).toLocaleDateString() %> to <%= new Date(l.end_date).toLocaleDateString() %><br><small><%= l.reason %></small></p><% }) %><% } %></section></div>
<script>const st=document.getElementById('duty-station'),un=document.getElementById('duty-unit'); if(st&&un)st.addEventListener('change',()=>{[...un.options].forEach((o,i)=>{if(i)o.hidden=!!st.value&&o.dataset.station!==st.value});un.value='';});</script>
<%- include("partials/footer") %>